[Unit]
Description=Amp Panel privileged network agent
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
User=root
Group=amp-panel
RuntimeDirectory=amp-panel
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007
ExecStart=/usr/bin/python3 /usr/lib/amp-panel/network_agent.py --socket /run/amp-panel/network-agent.sock
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
