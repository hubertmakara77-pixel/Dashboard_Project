SERIAL_PORT=/host/dev/ttyACM0
SERIAL_BAUDRATE=9600

DEVICE_NAME=
PERSISTED_STATE_FILE=/app/data/persisted_state.json
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

DATABASE_FILE=/app/data/measurements.db
DATABASE_MAX_RECORDS=0
HISTORY_MAX_POINTS=2000
SYSLOG_ENABLED=true
SYSLOG_HOST=host.docker.internal
SYSLOG_PORT=514
SYSLOG_APP_NAME=amp-dashboard
SYSLOG_FACILITY=16
SYSLOG_TIMEZONE=Europe/Warsaw
SYSLOG_HEARTBEAT_SECONDS=300
SYSLOG_EXPORT_FILE=/var/log/amp-dashboard/amp-dashboard.log
REMOTE_SYSLOG_ENABLED=false
REMOTE_SYSLOG_HOST=
REMOTE_SYSLOG_PORT=514
REMOTE_SYSLOG_PROTOCOL=tcp

TZ=Europe/Warsaw

SNMP_PORT=1161
SNMP_COMMUNITY=

NTP_SERVER=tempus1.gum.gov.pl
NTP_SERVER_FALLBACK_IP=194.146.251.100
NTP_PORT=123
NTP_TIMEOUT_SECONDS=3
NTP_CACHE_SECONDS=15

RADIUS_SERVER=
RADIUS_PORT=1812
RADIUS_SECRET=
RADIUS_TIMEOUT_SECONDS=3
RADIUS_RETRIES=1
RADIUS_NAS_IDENTIFIER=
